// Test: mutable variable inside module declaration
// --- Command: src/FunLang/bin/Release/net10.0/fn %input
// --- Input:
module Counter =
    let mut value = 0
    let inc x = value <- value + 1
    let get x = value

let _ = Counter.inc 0
let _ = Counter.inc 0
let _ = println (to_string (Counter.get 0))
// --- Output:
2
