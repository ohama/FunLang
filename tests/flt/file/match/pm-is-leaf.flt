// Test: wildcard inside constructor pattern
// --- Command: src/FunLang/bin/Release/net10.0/FunLang %input
// --- Input:
type Tree =
    | Leaf
    | Node of Tree * int * Tree

let isLeaf t =
    match t with
    | Leaf -> true
    | Node (_, _, _) -> false

let result = (isLeaf Leaf, isLeaf (Node (Leaf, 1, Leaf)))
// --- Output:
(true, false)
