// Test: List comprehension edge cases — empty, single, nested call, range expr (LANG-02)
// --- Command: /Users/ohama/vibe-coding/LangThree/src/FunLang/bin/Release/net10.0/FunLang %input
// --- Input:
let empty = [for x in [] -> x * 2]
let _ = println (to_string empty)
let single = [for x in [42] -> x + 1]
let _ = println (to_string single)
let nested = [for x in [1;2;3] -> to_string (x * x)]
let _ = println (to_string nested)
let r = [for i in 1..3 -> i * 10]
let _ = println (to_string r)
// --- Output:
[]
[43]
["1"; "4"; "9"]
[10; 20; 30]
()
