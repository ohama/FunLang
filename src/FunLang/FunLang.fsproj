<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="FsLexYacc" Version="11.3.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!--
    FsLexYacc Configuration (중요 원칙 / docs/build-issues.md 참조)
    1. OtherFlags 사용 필수: Module 메타데이터는 작동 안함
    2. Parser가 Lexer보다 먼저 생성되어야 함 (Lexer가 token 타입 사용)
    3. unicode 플래그 필수: char 기반 lexing (기본값은 byte)
    4. Lexer.fsl 헤더에 module 선언 금지 (module 플래그와 충돌)
    5. 생성 파일(Parser.fs, Lexer.fs, *.fsi)은 .gitignore에 추가
  -->
  <ItemGroup>
    <FsYacc Include="Parser.fsy">
      <OtherFlags>--module FunLang.GeneratedParser</OtherFlags>
    </FsYacc>
    <FsLex Include="Lexer.fsl">
      <OtherFlags>--module FunLang.GeneratedLexer --unicode</OtherFlags>
    </FsLex>
  </ItemGroup>

  <!--
    Compile Order (F# 필수 / 순서 변경 금지!)
    - Types.fs: Ast.fs 다음 (Position 타입 사용)
    - Unification.fs: Types.fs 다음
    - TypeInfer.fs: Unification.fs 다음
    - Parser.fs가 Lexer.fs보다 먼저 컴파일되어야 함
    (Lexer가 Parser에서 정의된 token 타입 사용)
  -->
  <ItemGroup>
    <Compile Include="Ast.fs" />
    <Compile Include="Errors.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Unification.fs" />
    <Compile Include="TypeInfer.fs" />
    <Compile Include="Diagnostic.fs" />
    <Compile Include="ErrorFormatter.fs" />
    <Compile Include="Logging.fs" />
    <Compile Include="Options.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Indentation.fs" />
    <Compile Include="ParserWrapper.fs" />
    <Compile Include="ConstructorResolver.fs" />
    <Compile Include="Interpreter.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
