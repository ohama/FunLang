%{
open FunLang.Ast

// =============================================================================
// Block Item Types and Transformation
// =============================================================================

/// Intermediate representation for block items before transformation
type BlockItem =
    | BILet of string * Expr       // let x = e (block-local, no IN)
    | BILetRec of string * Expr    // let rec f = e (block-local, no IN)
    | BIExpr of Expr               // standalone expression

/// Transform a list of block items into a single nested expression
/// [BILet("x", 10); BILet("y", 20); BIExpr(x+y)]
/// → ELet("x", 10, ELet("y", 20, x+y))
let rec blockToExpr (items: BlockItem list) : Expr =
    match items with
    | [] ->
        // Empty block returns unit
        ELiteral LUnit

    | [BIExpr e] ->
        // Single expression - just return it
        e

    | [BILet(name, value)] ->
        // Single binding with no following expression - body is unit
        ELet(name, value, ELiteral LUnit)

    | [BILetRec(name, value)] ->
        ELetRec(name, value, ELiteral LUnit)

    | BIExpr e :: rest ->
        // Expression for side effects, then continue
        // Use wildcard binding to sequence: let _ = e in rest
        ELet("_", e, blockToExpr rest)

    | BILet(name, value) :: rest ->
        // Binding scopes over the rest
        ELet(name, value, blockToExpr rest)

    | BILetRec(name, value) :: rest ->
        ELetRec(name, value, blockToExpr rest)

%}

// Tokens with values
%token <int> INT
%token <bool> BOOL
%token <string> STRING
%token <string> IDENT

// Keywords
%token LET REC IN
%token IF THEN ELSE
%token FUN ARROW
%token MATCH WITH WHEN
%token TYPE OF
%token AND_KW OR_KW NOT_KW
%token TRUE FALSE

// Operators
%token PLUS MINUS STAR SLASH PERCENT
%token EQ NEQ LT GT LTE GTE
%token DOUBLECOLON

// Delimiters
%token LPAREN RPAREN
%token LBRACKET RBRACKET
%token COMMA SEMICOLON
%token COLON PIPE UNDERSCORE

// Special
%token EOF
%token NEWLINE INDENT DEDENT

// Precedence (lowest to highest)
%right ARROW
%right DOUBLECOLON
%left OR_KW
%left AND_KW
%left EQ NEQ
%left LT GT LTE GTE
%left PLUS MINUS
%left STAR SLASH PERCENT
%nonassoc UMINUS UNOT

// Start symbol
%start prog
%type <Expr> prog

%%

prog:
    | expr EOF                          { $1 }
;

expr:
    | LET IDENT EQ expr IN nl_opt expr         { ELet($2, $4, $7) }
    | LET REC IDENT EQ expr IN nl_opt expr     { ELetRec($3, $5, $8) }
    | IF expr THEN nl_opt expr ELSE nl_opt expr { EIf($2, $5, $8) }
    | FUN IDENT ARROW nl_opt expr              { ELambda($2, $5) }
    | MATCH expr WITH match_cases_start        { EMatch($2, $4) }
    | block                                    { $1 }
    | cons_expr                                { $1 }
;

// Optional NEWLINE (for multiline expressions)
nl_opt:
    | /* empty */                       { () }
    | NEWLINE                           { () }
;

// =============================================================================
// Pattern Matching
// =============================================================================

// Handle optional NEWLINE between match cases (for indented match expressions)
match_cases:
    | match_case                            { [$1] }
    | match_case match_cases                { $1 :: $2 }
    | match_case NEWLINE match_cases        { $1 :: $3 }
;

match_case:
    | PIPE pattern ARROW nl_opt expr                   { ($2, None, $5) }
    | PIPE pattern WHEN expr ARROW nl_opt expr         { ($2, Some $4, $7) }
;

// Handle NEWLINE before first PIPE (for indented match)
match_cases_start:
    | match_cases                           { $1 }
    | NEWLINE match_cases                   { $2 }
;

pattern:
    | cons_pattern                      { $1 }
;

cons_pattern:
    | pattern_atom DOUBLECOLON cons_pattern   { PCons($1, $3) }
    | pattern_atom                            { $1 }
;

pattern_atom:
    | UNDERSCORE                        { PWildcard }
    | IDENT                             { PVariable $1 }
    | INT                               { PLiteral(LInt $1) }
    | TRUE                              { PLiteral(LBool true) }
    | FALSE                             { PLiteral(LBool false) }
    | STRING                            { PLiteral(LString $1) }
    | LPAREN RPAREN                     { PLiteral LUnit }
    | LPAREN pattern RPAREN             { $2 }
    | LPAREN pattern COMMA pattern_tuple_rest RPAREN { PTuple($2 :: $4) }
    | LBRACKET RBRACKET                 { PList [] }
    | LBRACKET pattern_list RBRACKET    { PList $2 }
;

pattern_tuple_rest:
    | pattern                           { [$1] }
    | pattern COMMA pattern_tuple_rest  { $1 :: $3 }
;

pattern_list:
    | pattern                           { [$1] }
    | pattern SEMICOLON pattern_list    { $1 :: $3 }
;

// =============================================================================
// Indentation-based block
// =============================================================================

// A block is an indented sequence of block items
// Transformed to nested let expressions
block:
    | INDENT block_body DEDENT          { blockToExpr $2 }
;

// Block item: either a local binding (no IN) or an expression
// Key insight: no conflict because Follow(block_item) = {NEWLINE, DEDENT}
// which doesn't include IN, so the parser knows:
//   - see IN → it's an expr with LET...IN...
//   - see NEWLINE/DEDENT → it's a block-local binding
block_item:
    | LET IDENT EQ expr                 { BILet($2, $4) }
    | LET REC IDENT EQ expr             { BILetRec($3, $5) }
    | expr                              { BIExpr $1 }
;

block_body:
    | block_item                        { [$1] }
    | block_item NEWLINE block_body     { $1 :: $3 }
;

// =============================================================================
// Expression hierarchy
// =============================================================================

cons_expr:
    | or_expr DOUBLECOLON cons_expr     { ECons($1, $3) }
    | or_expr                           { $1 }
;

or_expr:
    | or_expr OR_KW and_expr            { EBinaryOp(Or, $1, $3) }
    | and_expr                          { $1 }
;

and_expr:
    | and_expr AND_KW eq_expr           { EBinaryOp(And, $1, $3) }
    | eq_expr                           { $1 }
;

eq_expr:
    | eq_expr EQ cmp_expr               { EBinaryOp(Eq, $1, $3) }
    | eq_expr NEQ cmp_expr              { EBinaryOp(Neq, $1, $3) }
    | cmp_expr                          { $1 }
;

cmp_expr:
    | cmp_expr LT add_expr              { EBinaryOp(Lt, $1, $3) }
    | cmp_expr GT add_expr              { EBinaryOp(Gt, $1, $3) }
    | cmp_expr LTE add_expr             { EBinaryOp(Lte, $1, $3) }
    | cmp_expr GTE add_expr             { EBinaryOp(Gte, $1, $3) }
    | add_expr                          { $1 }
;

add_expr:
    | add_expr PLUS mul_expr            { EBinaryOp(Add, $1, $3) }
    | add_expr MINUS mul_expr           { EBinaryOp(Sub, $1, $3) }
    | mul_expr                          { $1 }
;

mul_expr:
    | mul_expr STAR unary_expr          { EBinaryOp(Mul, $1, $3) }
    | mul_expr SLASH unary_expr         { EBinaryOp(Div, $1, $3) }
    | mul_expr PERCENT unary_expr       { EBinaryOp(Mod, $1, $3) }
    | unary_expr                        { $1 }
;

unary_expr:
    | MINUS unary_expr %prec UMINUS     { EUnaryOp(Neg, $2) }
    | NOT_KW unary_expr %prec UNOT      { EUnaryOp(Not, $2) }
    | app_expr                          { $1 }
;

app_expr:
    | app_expr atom                     { EApply($1, $2) }
    | atom                              { $1 }
;

atom:
    | INT                               { ELiteral(LInt $1) }
    | BOOL                              { ELiteral(LBool $1) }
    | STRING                            { ELiteral(LString $1) }
    | TRUE                              { ELiteral(LBool true) }
    | FALSE                             { ELiteral(LBool false) }
    | IDENT                             { EVariable $1 }
    | LPAREN RPAREN                     { ELiteral LUnit }
    | LPAREN expr RPAREN                { $2 }
    | LPAREN expr COMMA tuple_rest RPAREN { ETuple($2 :: $4) }
    | LBRACKET RBRACKET                 { EList [] }
    | LBRACKET list_items RBRACKET      { EList $2 }
;

tuple_rest:
    | expr                              { [$1] }
    | expr COMMA tuple_rest             { $1 :: $3 }
;

list_items:
    | expr                              { [$1] }
    | expr SEMICOLON list_items         { $1 :: $3 }
;

%%
