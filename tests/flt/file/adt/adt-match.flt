// Test: pattern matching on ADT constructors
// --- Command: src/FunLang/bin/Release/net10.0/FunLang %input
// --- Input:
type Color =
    | Red
    | Green
    | Blue

let describe c = match c with
| Red -> "red"
| Green -> "green"
| Blue -> "blue"

let result = describe Green
// --- Output:
"green"
