// Test: .Length property on strings
// --- Command: src/FunLang/bin/Release/net10.0/FunLang %input
// --- Input:
let s = "hello"
let n = String.length s
let _ = println (to_string n)
let m = String.length "hello"
let _ = println (to_string m)
let empty = String.length ""
let _ = println (to_string empty)
// --- Stdout:
5
5
0
