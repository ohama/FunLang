// Test: --emit-ast for simple ADT type declaration with constructor usage
// --- Command: /Users/ohama/vibe-coding/LangThree/src/FunLang/bin/Release/net10.0/FunLang --emit-ast %input
// --- Input:
type Color =
    | Red
    | Green
    | Blue
let c = Red
// --- Output:
TypeDecl "Color" [| Red | Green | Blue]
LetDecl ("c", Constructor "Red")
