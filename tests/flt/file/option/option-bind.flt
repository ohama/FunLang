// Test: Option bind (flatMap) using Prelude Option
// --- Command: src/FunLang/bin/Release/net10.0/FunLang %input
// --- Input:
let optionBind f opt = match opt with
| Some x -> f x
| None -> None

let safeDivide a b =
    if b = 0 then None
    else Some (a / b)

let result = optionBind (safeDivide 10) (Some 2)
// --- Output:
Some 5
