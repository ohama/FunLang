// Test: String.concat module function (STR-03)
// --- Command: src/FunLang/bin/Release/net10.0/FunLang %input
// --- Input:
let result = String.concat ", " ["a"; "b"; "c"]
let _ = println result
let empty = String.concat "-" []
let _ = println (to_string (empty = ""))
let single = String.concat ", " ["only"]
let _ = println single
// --- Output:
a, b, c
true
only
