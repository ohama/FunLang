// Test: sum of squares using fold
// --- Command: src/FunLang/bin/Release/net10.0/FunLang %input
// --- Input:
let result =
    let rec fold f = fun acc -> fun xs ->
        match xs with
        | [] -> acc
        | h :: t -> fold f (f acc h) t
    fold (fun acc -> fun x -> acc + x * x) 0 [1; 2; 3; 4; 5]
// --- Output:
55
