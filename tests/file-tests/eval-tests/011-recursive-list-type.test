type List 'a = Nil | Cons of 'a * List 'a

let rec sum = fun xs ->
  match xs with
  | Nil -> 0
  | Cons (h, t) -> h + sum t
sum (Cons (1, Cons (2, Cons (3, Cons (4, Nil)))))

