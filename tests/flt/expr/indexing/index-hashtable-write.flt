// Test IDX-04: ht.[key] <- v writes hashtable value
// --- Command: src/FunLang/bin/Release/net10.0/fn %input
// --- Input:
let ht = Hashtable.create ()
let _ = ht.["name"] <- "Alice"
let _ = ht.["score"] <- 95
let _ = println ht.["name"]
let _ = println (to_string ht.["score"])
// --- Output:
Alice
95
()
