<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="FsLexYacc" Version="11.3.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- FsLexYacc: Parser must be generated before Lexer -->
  <ItemGroup>
    <FsYacc Include="Parser.fsy">
      <OtherFlags>--module FunLang.GeneratedParser</OtherFlags>
    </FsYacc>
    <FsLex Include="Lexer.fsl">
      <OtherFlags>--module FunLang.GeneratedLexer --unicode</OtherFlags>
    </FsLex>
  </ItemGroup>

  <!-- Compile order matters in F# -->
  <ItemGroup>
    <Compile Include="Ast.fs" />
    <Compile Include="Errors.fs" />
    <Compile Include="Logging.fs" />
    <Compile Include="Options.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="ParserWrapper.fs" />
    <Compile Include="Interpreter.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
