// --COMMAND: dotnet run --project src/FunLang -- %s
// --INPUT

// =============================================================================
// FunLang Sorting Algorithms Collection
// =============================================================================
// This file demonstrates multiple sorting algorithms implemented in FunLang,
// showcasing:
//   - User-defined types (Tree, List)
//   - Higher-order functions
//   - Pattern matching
//   - Recursion
// =============================================================================

// -----------------------------------------------------------------------------
// 1. Binary Search Tree (BST) Sort
// -----------------------------------------------------------------------------
// Uses a binary search tree to sort elements.
// Time Complexity: O(n log n) average, O(n^2) worst case
// -----------------------------------------------------------------------------

type BST 'a =
  | Empty
  | Node of 'a * BST 'a * BST 'a

let rec bstInsert = fun tree -> fun x ->
  match tree with
  | Empty -> Node (x, Empty, Empty)
  | Node (v, left, right) ->
    if x <= v then
      Node (v, bstInsert left x, right)
    else
      Node (v, left, bstInsert right x)

let rec bstInorder = fun tree ->
  match tree with
  | Empty -> []
  | Node (v, left, right) ->
    let leftList = bstInorder left in
    let rightList = bstInorder right in
    let rec append = fun xs -> fun ys ->
      match xs with
      | [] -> ys
      | h :: t -> h :: append t ys
    in
    append leftList (v :: rightList)

let rec bstFromList = fun xs ->
  match xs with
  | [] -> Empty
  | h :: t -> bstInsert (bstFromList t) h

let bstSort = fun xs -> bstInorder (bstFromList xs)

// -----------------------------------------------------------------------------
// 2. Merge Sort
// -----------------------------------------------------------------------------
// Divide and conquer algorithm that splits the list, sorts recursively,
// and merges the sorted halves.
// Time Complexity: O(n log n)
// -----------------------------------------------------------------------------

let rec length = fun xs ->
  match xs with
  | [] -> 0
  | _ :: t -> 1 + length t

let rec take = fun n -> fun xs ->
  if n <= 0 then []
  else match xs with
       | [] -> []
       | h :: t -> h :: take (n - 1) t

let rec drop = fun n -> fun xs ->
  if n <= 0 then xs
  else match xs with
       | [] -> []
       | _ :: t -> drop (n - 1) t

let rec merge = fun xs -> fun ys ->
  match xs with
  | [] -> ys
  | xh :: xt ->
    match ys with
    | [] -> xs
    | yh :: yt ->
      if xh <= yh then
        xh :: merge xt ys
      else
        yh :: merge xs yt

let rec mergeSort = fun xs ->
  match xs with
  | [] -> []
  | [x] -> [x]
  | _ ->
    let n = length xs in
    let half = n / 2 in
    let left = take half xs in
    let right = drop half xs in
    merge (mergeSort left) (mergeSort right)

// -----------------------------------------------------------------------------
// 3. Quick Sort
// -----------------------------------------------------------------------------
// Divide and conquer using a pivot element.
// Time Complexity: O(n log n) average, O(n^2) worst case
// -----------------------------------------------------------------------------

let rec filter = fun pred -> fun xs ->
  match xs with
  | [] -> []
  | h :: t ->
    if pred h then
      h :: filter pred t
    else
      filter pred t

let rec appendList = fun xs -> fun ys ->
  match xs with
  | [] -> ys
  | h :: t -> h :: appendList t ys

let rec quickSort = fun xs ->
  match xs with
  | [] -> []
  | [x] -> [x]
  | pivot :: rest ->
    let smaller = filter (fun x -> x <= pivot) rest in
    let larger = filter (fun x -> x > pivot) rest in
    let sortedSmaller = quickSort smaller in
    let sortedLarger = quickSort larger in
    appendList sortedSmaller (pivot :: sortedLarger)

// -----------------------------------------------------------------------------
// 4. Insertion Sort
// -----------------------------------------------------------------------------
// Builds the sorted list one element at a time.
// Time Complexity: O(n^2)
// -----------------------------------------------------------------------------

let rec insert = fun x -> fun xs ->
  match xs with
  | [] -> [x]
  | h :: t ->
    if x <= h then
      x :: xs
    else
      h :: insert x t

let rec insertionSort = fun xs ->
  match xs with
  | [] -> []
  | h :: t -> insert h (insertionSort t)

// -----------------------------------------------------------------------------
// 5. Selection Sort
// -----------------------------------------------------------------------------
// Repeatedly finds the minimum element and moves it to the front.
// Time Complexity: O(n^2)
// -----------------------------------------------------------------------------

let rec findMin = fun xs ->
  match xs with
  | [] -> 0
  | [x] -> x
  | h :: t ->
    let minTail = findMin t in
    if h <= minTail then h else minTail

let rec removeFirst = fun x -> fun xs ->
  match xs with
  | [] -> []
  | h :: t ->
    if h = x then t
    else h :: removeFirst x t

let rec selectionSort = fun xs ->
  match xs with
  | [] -> []
  | _ ->
    let minVal = findMin xs in
    let remaining = removeFirst minVal xs in
    minVal :: selectionSort remaining

// -----------------------------------------------------------------------------
// 6. Bubble Sort (Single Pass Demo)
// -----------------------------------------------------------------------------
// Repeatedly swaps adjacent elements if they are in wrong order.
// Time Complexity: O(n^2)
// -----------------------------------------------------------------------------

let rec bubblePass = fun xs ->
  match xs with
  | [] -> []
  | [x] -> [x]
  | x :: y :: rest ->
    if x <= y then
      x :: bubblePass (y :: rest)
    else
      y :: bubblePass (x :: rest)

let rec bubbleSort = fun xs ->
  let n = length xs in
  let rec loop = fun count -> fun ys ->
    if count <= 0 then ys
    else loop (count - 1) (bubblePass ys)
  in
  loop n xs

// -----------------------------------------------------------------------------
// Test Data
// -----------------------------------------------------------------------------

let testList = [64; 34; 25; 12; 22; 11; 90; 5; 77; 33]

// -----------------------------------------------------------------------------
// Run All Sorting Algorithms and Compare Results
// -----------------------------------------------------------------------------

let result1 = bstSort testList in
let result2 = mergeSort testList in
let result3 = quickSort testList in
let result4 = insertionSort testList in
let result5 = selectionSort testList in
let result6 = bubbleSort testList in

// Verify all results are equal
let rec listEqual = fun xs -> fun ys ->
  match xs with
  | [] -> match ys with | [] -> true | _ -> false
  | xh :: xt ->
    match ys with
    | [] -> false
    | yh :: yt -> if xh = yh then listEqual xt yt else false

let allEqual =
  listEqual result1 result2 and
  listEqual result2 result3 and
  listEqual result3 result4 and
  listEqual result4 result5 and
  listEqual result5 result6

// Return tuple: (all algorithms produce same result, the sorted list)
(allEqual, result1)

// --EXPECTED

(true, [5; 11; 12; 22; 25; 33; 34; 64; 77; 90])
