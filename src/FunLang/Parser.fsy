%{
open FunLang.Ast

// =============================================================================
// Position Helpers
// =============================================================================

/// Create a Located value from parseState and a node
let inline locate (parseState: FSharp.Text.Parsing.IParseState) (node: 'T) : Located<'T> =
    let pos = parseState.InputStartPosition 1
    { Node = node; Pos = { Line = pos.Line; Column = pos.Column; File = None } }

/// Create a Located value with no position (for synthesized nodes)
let inline noLoc (node: 'T) : Located<'T> =
    { Node = node; Pos = noPos }

// =============================================================================
// Block Item Types and Transformation
// =============================================================================

/// Intermediate representation for block items before transformation
type BlockItem =
    | BILet of string * LExpr       // let x = e (block-local, no IN)
    | BILetRec of string * LExpr    // let rec f = e (block-local, no IN)
    | BIExpr of LExpr               // standalone expression

/// Transform a list of block items into a single nested expression
/// [BILet("x", 10); BILet("y", 20); BIExpr(x+y)]
/// → ELet("x", 10, ELet("y", 20, x+y))
let rec blockToExpr (items: BlockItem list) : Expr =
    match items with
    | [] ->
        // Empty block returns unit
        ELiteral LUnit

    | [BIExpr e] ->
        // Single expression - just unwrap and return
        e.Node

    | [BILet(name, value)] ->
        // Single binding with no following expression - body is unit
        ELet(name, value, noLoc (ELiteral LUnit))

    | [BILetRec(name, value)] ->
        ELetRec(name, value, noLoc (ELiteral LUnit))

    | BIExpr e :: rest ->
        // Expression for side effects, then continue
        // Use wildcard binding to sequence: let _ = e in rest
        ELet("_", e, noLoc (blockToExpr rest))

    | BILet(name, value) :: rest ->
        // Binding scopes over the rest
        ELet(name, value, noLoc (blockToExpr rest))

    | BILetRec(name, value) :: rest ->
        ELetRec(name, value, noLoc (blockToExpr rest))

%}

// Tokens with values
%token <int> INT
%token <bool> BOOL
%token <string> STRING
%token <string> IDENT
%token <string> TYPEVAR

// Keywords
%token LET REC IN
%token IF THEN ELSE
%token FUN ARROW
%token MATCH WITH WHEN
%token TYPE OF
%token AND_KW OR_KW NOT_KW
%token TRUE FALSE

// Operators
%token PLUS MINUS STAR SLASH PERCENT
%token EQ NEQ LT GT LTE GTE
%token DOUBLECOLON

// Delimiters
%token LPAREN RPAREN
%token LBRACKET RBRACKET
%token COMMA SEMICOLON
%token COLON PIPE UNDERSCORE

// Special
%token EOF
%token NEWLINE INDENT DEDENT

// Precedence (lowest to highest)
%right ARROW
%right DOUBLECOLON
%left OR_KW
%left AND_KW
%left EQ NEQ
%left LT GT LTE GTE
%left PLUS MINUS
%left STAR SLASH PERCENT
%nonassoc UMINUS UNOT

// Start symbol
%start prog
%type <Program> prog

%%

prog:
    | program EOF                       { $1 }
;

// =============================================================================
// Program: type definitions + main expression
// =============================================================================

program:
    | top_level_body                        { { TypeDefs = []; MainExpr = Some (noLoc (blockToExpr $1)) } }
    | type_def_or_list top_level_body       { { TypeDefs = $1; MainExpr = Some (noLoc (blockToExpr $2)) } }
    | type_def_or_list                      { { TypeDefs = $1; MainExpr = None } }
;

// =============================================================================
// Top-level body: like block_body but without INDENT/DEDENT
// Allows optional 'in' for multiline let expressions at top-level
// =============================================================================

top_level_body:
    | top_level_item                            { [$1] }
    | top_level_item NEWLINE top_level_body     { $1 :: $3 }
;

// Top-level item: same as block_item
// LET without IN becomes block-local binding
// expr (including LET...IN...expr) becomes expression
top_level_item:
    | LET IDENT EQ expr                 { BILet($2, locate parseState $4) }
    | LET REC IDENT EQ expr             { BILetRec($3, locate parseState $5) }
    | expr                              { BIExpr (locate parseState $1) }
;

// Type definition list - handles optional trailing NEWLINE
type_def_or_list:
    | type_def                              { [$1] }
    | type_def NEWLINE                      { [$1] }
    | type_def NEWLINE type_def_or_list     { $1 :: $3 }
;

// =============================================================================
// Type Definitions
// =============================================================================

type_def:
    | TYPE IDENT type_params EQ constructor_list  { { Name = $2; TypeParams = $3; Constructors = $5 } }
;

type_params:
    | /* empty */                       { [] }
    | type_params TYPEVAR               { $1 @ [$2] }
;

constructor_list:
    | constructor_def                           { [$1] }
    | constructor_def PIPE constructor_list     { $1 :: $3 }
;

constructor_def:
    | IDENT                             { ($1, None) }
    | IDENT OF type_expr                { ($1, Some $3) }
;

// =============================================================================
// Type Expressions (for constructor argument types)
// =============================================================================

// Tuple types have lower precedence: 'a * 'b * 'c
type_expr:
    | type_app_expr STAR type_tuple_rest   { TETuple($1 :: $3) }
    | type_app_expr                        { $1 }
;

type_tuple_rest:
    | type_app_expr                        { [$1] }
    | type_app_expr STAR type_tuple_rest   { $1 :: $3 }
;

// Type application: List 'a, Option int
type_app_expr:
    | IDENT type_arg_list                  { TEApp($1, $2) }
    | type_atom                            { $1 }
;

// Type arguments (one or more type atoms)
type_arg_list:
    | type_atom                            { [$1] }
    | type_atom type_arg_list              { $1 :: $2 }
;

// Atomic types: 'a, int, (type_expr)
type_atom:
    | TYPEVAR                              { TEVar $1 }
    | IDENT                                { TEName $1 }
    | LPAREN type_expr RPAREN              { $2 }
;

expr:
    | LET IDENT EQ expr IN nl_opt expr         { ELet($2, locate parseState $4, locate parseState $7) }
    | LET REC IDENT EQ expr IN nl_opt expr     { ELetRec($3, locate parseState $5, locate parseState $8) }
    | IF expr THEN nl_opt expr nl_opt ELSE nl_opt expr { EIf(locate parseState $2, locate parseState $5, locate parseState $9) }
    | FUN IDENT ARROW nl_opt expr              { ELambda($2, locate parseState $5) }
    | MATCH expr WITH match_cases_start        { EMatch(locate parseState $2, $4) }
    | block                                    { $1 }
    | cons_expr                                { $1 }
;

// Optional NEWLINE (for multiline expressions)
nl_opt:
    | /* empty */                       { () }
    | NEWLINE                           { () }
;

// =============================================================================
// Pattern Matching
// =============================================================================

// Handle optional NEWLINE between match cases (for indented match expressions)
match_cases:
    | match_case                            { [$1] }
    | match_case match_cases                { $1 :: $2 }
    | match_case NEWLINE match_cases        { $1 :: $3 }
;

match_case:
    | PIPE pattern ARROW nl_opt expr                   { (locate parseState $2, None, locate parseState $5) }
    | PIPE pattern WHEN expr ARROW nl_opt expr         { (locate parseState $2, Some (locate parseState $4), locate parseState $7) }
;

// Handle NEWLINE before first PIPE (for indented match)
match_cases_start:
    | match_cases                           { $1 }
    | NEWLINE match_cases                   { $2 }
;

pattern:
    | cons_pattern                      { $1 }
;

cons_pattern:
    | IDENT pattern_atom                      { PConstructor($1, Some (locate parseState $2)) }
    | pattern_atom DOUBLECOLON cons_pattern   { PCons(locate parseState $1, locate parseState $3) }
    | pattern_atom                            { $1 }
;

pattern_atom:
    | UNDERSCORE                        { PWildcard }
    | IDENT                             { PVariable $1 }
    | INT                               { PLiteral(LInt $1) }
    | TRUE                              { PLiteral(LBool true) }
    | FALSE                             { PLiteral(LBool false) }
    | STRING                            { PLiteral(LString $1) }
    | LPAREN RPAREN                     { PLiteral LUnit }
    | LPAREN pattern RPAREN             { $2 }
    | LPAREN pattern COMMA pattern_tuple_rest RPAREN { PTuple(locate parseState $2 :: $4) }
    | LBRACKET RBRACKET                 { PList [] }
    | LBRACKET pattern_list RBRACKET    { PList $2 }
;

pattern_tuple_rest:
    | pattern                           { [locate parseState $1] }
    | pattern COMMA pattern_tuple_rest  { locate parseState $1 :: $3 }
;

pattern_list:
    | pattern                           { [locate parseState $1] }
    | pattern SEMICOLON pattern_list    { locate parseState $1 :: $3 }
;

// =============================================================================
// Indentation-based block
// =============================================================================

// A block is an indented sequence of block items
// Transformed to nested let expressions
block:
    | INDENT block_body DEDENT          { blockToExpr $2 }
;

// Block item: either a local binding (no IN) or an expression
// Key insight: no conflict because Follow(block_item) = {NEWLINE, DEDENT}
// which doesn't include IN, so the parser knows:
//   - see IN → it's an expr with LET...IN...
//   - see NEWLINE/DEDENT → it's a block-local binding
block_item:
    | LET IDENT EQ expr                 { BILet($2, locate parseState $4) }
    | LET REC IDENT EQ expr             { BILetRec($3, locate parseState $5) }
    | expr                              { BIExpr (locate parseState $1) }
;

block_body:
    | block_item                        { [$1] }
    | block_item NEWLINE block_body     { $1 :: $3 }
;

// =============================================================================
// Expression hierarchy
// =============================================================================

cons_expr:
    | or_expr DOUBLECOLON cons_expr     { ECons(locate parseState $1, locate parseState $3) }
    | or_expr                           { $1 }
;

or_expr:
    | or_expr OR_KW and_expr            { EBinaryOp(Or, locate parseState $1, locate parseState $3) }
    | and_expr                          { $1 }
;

and_expr:
    | and_expr AND_KW eq_expr           { EBinaryOp(And, locate parseState $1, locate parseState $3) }
    | eq_expr                           { $1 }
;

eq_expr:
    | eq_expr EQ cmp_expr               { EBinaryOp(Eq, locate parseState $1, locate parseState $3) }
    | eq_expr NEQ cmp_expr              { EBinaryOp(Neq, locate parseState $1, locate parseState $3) }
    | cmp_expr                          { $1 }
;

cmp_expr:
    | cmp_expr LT add_expr              { EBinaryOp(Lt, locate parseState $1, locate parseState $3) }
    | cmp_expr GT add_expr              { EBinaryOp(Gt, locate parseState $1, locate parseState $3) }
    | cmp_expr LTE add_expr             { EBinaryOp(Lte, locate parseState $1, locate parseState $3) }
    | cmp_expr GTE add_expr             { EBinaryOp(Gte, locate parseState $1, locate parseState $3) }
    | add_expr                          { $1 }
;

add_expr:
    | add_expr PLUS mul_expr            { EBinaryOp(Add, locate parseState $1, locate parseState $3) }
    | add_expr MINUS mul_expr           { EBinaryOp(Sub, locate parseState $1, locate parseState $3) }
    | mul_expr                          { $1 }
;

mul_expr:
    | mul_expr STAR unary_expr          { EBinaryOp(Mul, locate parseState $1, locate parseState $3) }
    | mul_expr SLASH unary_expr         { EBinaryOp(Div, locate parseState $1, locate parseState $3) }
    | mul_expr PERCENT unary_expr       { EBinaryOp(Mod, locate parseState $1, locate parseState $3) }
    | unary_expr                        { $1 }
;

unary_expr:
    | MINUS unary_expr %prec UMINUS     { EUnaryOp(Neg, locate parseState $2) }
    | NOT_KW unary_expr %prec UNOT      { EUnaryOp(Not, locate parseState $2) }
    | app_expr                          { $1 }
;

app_expr:
    | app_expr atom                     { EApply(locate parseState $1, locate parseState $2) }
    | atom                              { $1 }
;

atom:
    | INT                               { ELiteral(LInt $1) }
    | BOOL                              { ELiteral(LBool $1) }
    | STRING                            { ELiteral(LString $1) }
    | TRUE                              { ELiteral(LBool true) }
    | FALSE                             { ELiteral(LBool false) }
    | IDENT                             { EVariable $1 }
    | LPAREN RPAREN                     { ELiteral LUnit }
    | LPAREN expr RPAREN                { $2 }
    | LPAREN expr COMMA tuple_rest RPAREN { ETuple(locate parseState $2 :: $4) }
    | LBRACKET RBRACKET                 { EList [] }
    | LBRACKET list_items RBRACKET      { EList $2 }
;

tuple_rest:
    | expr                              { [locate parseState $1] }
    | expr COMMA tuple_rest             { locate parseState $1 :: $3 }
;

list_items:
    | expr                              { [locate parseState $1] }
    | expr SEMICOLON list_items         { locate parseState $1 :: $3 }
;

%%
