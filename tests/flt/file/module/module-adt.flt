// Test: module containing ADT with constructor matching
// --- Command: src/FunLang/bin/Release/net10.0/fn %input
// --- Input:
module Color =
    type T =
        | Red
        | Green
        | Blue
    let toInt c =
        match c with
        | Red -> 1
        | Green -> 2
        | Blue -> 3

open Color
let result = toInt Green
// --- Output:
2
