// --COMMAND: dotnet run --project src/FunLang -- %s
// --INPUT

// =============================================================================
// FunLang Sorting Algorithms - Pattern Matching Version
// =============================================================================
// Uses pattern matching with exhaustive patterns.
// Pattern warnings are tested separately in warning-tests/.
// =============================================================================

// Helper functions with exhaustive patterns (wildcard fallback for lists)
let head = fun xs ->
  match xs with
  | h :: _ -> h
  | _ -> 0

let tail = fun xs ->
  match xs with
  | _ :: t -> t
  | _ -> []

// Length of a list
let rec length = fun xs ->
  match xs with
  | [] -> 0
  | _ -> 1 + length (tail xs)

// Append two lists
let rec append = fun xs -> fun ys ->
  match xs with
  | [] -> ys
  | _ -> (head xs) :: append (tail xs) ys

// Take first n elements
let rec take = fun n -> fun xs ->
  match n <= 0 with
  | true -> []
  | false ->
    match xs with
    | [] -> []
    | _ -> (head xs) :: take (n - 1) (tail xs)

// Drop first n elements
let rec drop = fun n -> fun xs ->
  match n <= 0 with
  | true -> xs
  | false ->
    match xs with
    | [] -> []
    | _ -> drop (n - 1) (tail xs)

// =============================================================================
// Insertion Sort
// =============================================================================

let rec insert = fun x -> fun xs ->
  match xs with
  | [] -> [x]
  | _ ->
    match x <= head xs with
    | true -> x :: xs
    | false -> (head xs) :: insert x (tail xs)

let rec insertionSort = fun xs ->
  match xs with
  | [] -> []
  | _ -> insert (head xs) (insertionSort (tail xs))

// =============================================================================
// Merge Sort
// =============================================================================

let rec merge = fun xs -> fun ys ->
  match xs with
  | [] -> ys
  | _ ->
    match ys with
    | [] -> xs
    | _ ->
      match head xs <= head ys with
      | true -> (head xs) :: merge (tail xs) ys
      | false -> (head ys) :: merge xs (tail ys)

let rec mergeSort = fun xs ->
  let n = length xs
  match n <= 1 with
  | true -> xs
  | false ->
    let half = n / 2
    let left = take half xs
    let right = drop half xs
    merge (mergeSort left) (mergeSort right)

// =============================================================================
// Quick Sort
// =============================================================================

let rec filter = fun pred -> fun xs ->
  match xs with
  | [] -> []
  | _ ->
    match pred (head xs) with
    | true -> (head xs) :: filter pred (tail xs)
    | false -> filter pred (tail xs)

let rec quickSort = fun xs ->
  match xs with
  | [] -> []
  | _ ->
    let n = length xs
    match n = 1 with
    | true -> xs
    | false ->
      let pivot = head xs
      let rest = tail xs
      let smaller = filter (fun x -> x <= pivot) rest
      let larger = filter (fun x -> x > pivot) rest
      append (quickSort smaller) (pivot :: quickSort larger)

// =============================================================================
// Selection Sort
// =============================================================================

let rec findMin = fun xs ->
  match xs with
  | [] -> 0
  | _ ->
    let n = length xs
    match n = 1 with
    | true -> head xs
    | false ->
      let minTail = findMin (tail xs)
      match head xs <= minTail with
      | true -> head xs
      | false -> minTail

let rec removeFirst = fun x -> fun xs ->
  match xs with
  | [] -> []
  | _ ->
    match head xs = x with
    | true -> tail xs
    | false -> (head xs) :: removeFirst x (tail xs)

let rec selectionSort = fun xs ->
  match xs with
  | [] -> []
  | _ ->
    let minVal = findMin xs
    let remaining = removeFirst minVal xs
    minVal :: selectionSort remaining

// =============================================================================
// Test Data and Verification
// =============================================================================

let testList = [64; 34; 25; 12; 22; 11; 90; 5; 77; 33]

let result1 = insertionSort testList
let result2 = mergeSort testList
let result3 = quickSort testList
let result4 = selectionSort testList

// Simple list equality check
let rec listEqual = fun xs -> fun ys ->
  match xs with
  | [] ->
    match ys with
    | [] -> true
    | _ -> false
  | _ ->
    match ys with
    | [] -> false
    | _ ->
      match head xs = head ys with
      | true -> listEqual (tail xs) (tail ys)
      | false -> false

let allEqual =
  listEqual result1 result2 and
  listEqual result2 result3 and
  listEqual result3 result4

// Return (all equal, sorted result)
(allEqual, result1)

// --EXPECTED

(true, [5; 11; 12; 22; 25; 33; 34; 64; 77; 90])

