// Test: E0310 Immutable field assignment — assigning to non-mutable field
// --- Command: src/FunLang/bin/Release/net10.0/fn %input
// --- ExitCode: 1
// --- Stderr:
error[E0310]: Field 'x' of record type P is immutable and cannot be assigned
// --- Input:
type P = { x: int; y: int }
let p = { x = 1; y = 2 }
let _ = p.x <- 5
