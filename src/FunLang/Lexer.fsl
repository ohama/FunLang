{
// ============================================================================
// 중요: 이 헤더에 module 선언 금지!
// --module 플래그(FunLang.fsproj)가 모듈명을 지정함
// 헤더에 module 선언하면 FS0010 에러 발생
// 상세: docs/build-issues.md #2 참조
// ============================================================================
open System.Text
open FSharp.Text.Lexing
open FunLang.GeneratedParser

let lexeme = LexBuffer<_>.LexemeString

// =============================================================================
// Comment Buffer Mechanism
// FsLex can only return one token at a time, so we buffer comments
// and return them with the next token (via tokenize wrapper)
// =============================================================================
// Stores: (text, line, column) where line/column are 0-based
let mutable private pendingComment: (string * int * int) option = None

/// Get and clear any pending comment (called after each token)
/// Returns (text, line, column) where line/column are 0-based
let getAndClearComment () =
    let result = pendingComment
    pendingComment <- None
    result

/// Set a pending comment with position (called from lineComment rule)
let private setPendingComment (text: string) (line: int) (col: int) =
    pendingComment <- Some (text, line, col)

let keywords =
    Map.ofList [
        "let", LET
        "rec", REC
        "in", IN
        "if", IF
        "then", THEN
        "else", ELSE
        "fun", FUN
        "match", MATCH
        "with", WITH
        "when", WHEN
        "type", TYPE
        "of", OF
        "and", AND_KW
        "or", OR_KW
        "not", NOT_KW
        "true", TRUE
        "false", FALSE
    ]

// Extract type variable name (everything after the quote)
let typeVarName (s: string) = s.Substring(1)

let identOrKeyword s =
    match Map.tryFind s keywords with
    | Some token -> token
    | None -> IDENT s
}

let digit = ['0'-'9']
let alpha = ['a'-'z' 'A'-'Z' '_']
let alphanum = alpha | digit
let whitespace = [' ' '\t' '\r']
let newline = '\n'

rule token = parse
    | whitespace+       { token lexbuf }
    | newline           { lexbuf.EndPos <- lexbuf.EndPos.NextLine; NEWLINE }
    | "//"              { let pos = lexbuf.StartPos in lineComment (StringBuilder()) pos.pos_lnum pos.pos_cnum lexbuf }
    | digit+            { INT (int (lexeme lexbuf)) }
    | '"'               { STRING (stringToken "" lexbuf) }
    | '\'' ['a'-'z']+   { TYPEVAR (typeVarName (lexeme lexbuf)) }
    | alpha alphanum*   { identOrKeyword (lexeme lexbuf) }
    | '+'               { PLUS }
    | '-'               { MINUS }
    | '*'               { STAR }
    | '/'               { SLASH }
    | '%'               { PERCENT }
    | '('               { LPAREN }
    | ')'               { RPAREN }
    | '['               { LBRACKET }
    | ']'               { RBRACKET }
    | ','               { COMMA }
    | ';'               { SEMICOLON }
    | ':'               { COLON }
    | "::"              { DOUBLECOLON }
    | "->"              { ARROW }
    | '|'               { PIPE }
    | '_'               { UNDERSCORE }
    | "<="              { LTE }
    | ">="              { GTE }
    | "<>"              { NEQ }
    | "!="              { NEQ }
    | "=="              { EQ }
    | '='               { EQ }
    | '<'               { LT }
    | '>'               { GT }
    | eof               { EOF }
    | _                 { failwithf "Unexpected character: %s" (lexeme lexbuf) }

and stringToken acc = parse
    | '"'               { acc }
    | "\\n"             { stringToken (acc + "\n") lexbuf }
    | "\\t"             { stringToken (acc + "\t") lexbuf }
    | "\\r"             { stringToken (acc + "\r") lexbuf }
    | "\\\""            { stringToken (acc + "\"") lexbuf }
    | "\\\\"            { stringToken (acc + "\\") lexbuf }
    | [^ '"' '\\']+     { stringToken (acc + lexeme lexbuf) lexbuf }
    | eof               { failwith "Unterminated string" }
    | _                 { stringToken (acc + lexeme lexbuf) lexbuf }

and lineComment acc line col = parse
    | newline           {
        lexbuf.EndPos <- lexbuf.EndPos.NextLine
        setPendingComment (acc.ToString()) line col
        NEWLINE
      }
    | eof               {
        setPendingComment (acc.ToString()) line col
        EOF
      }
    | _                 {
        acc.Append(lexeme lexbuf) |> ignore
        lineComment acc line col lexbuf
      }
