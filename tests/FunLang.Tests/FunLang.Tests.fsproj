    <Compile Include="IndentationTests.fs" />
    <Compile Include="PatternTests.fs" />
    <Compile Include="TypeTests.fs" />
    <Compile Include="UserDefinedTypeTests.fs" />
    <Compile Include="SuggestionTests.fs" />
    <Compile Include="ErrorExplanationTests.fs" />
    <Compile Include="DiagnosticTests.fs" />
    <Compile Include="ErrorFormatterTests.fs" />
    <Compile Include="FileBasedTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
