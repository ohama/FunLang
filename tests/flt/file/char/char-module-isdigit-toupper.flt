// Test: Char.isDigit and Char.toUpper module functions (STR-02)
// --- Command: src/FunLang/bin/Release/net10.0/fn %input
// --- Input:
let _ = println (to_string (Char.isDigit '3'))
let _ = println (to_string (Char.isDigit 'a'))
let upper = Char.toUpper 'a'
let _ = println (to_string upper)
let _ = println (to_string (Char.isLetter 'z'))
// --- Output:
true
false
'A'
true
