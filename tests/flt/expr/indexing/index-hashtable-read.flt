// Test IDX-03: ht.[key] reads hashtable value
// --- Command: src/FunLang/bin/Release/net10.0/fn %input
// --- Input:
let ht = Hashtable.create ()
let _ = Hashtable.set ht "x" 100
let _ = Hashtable.set ht "y" 200
let _ = println (to_string ht.["x"])
let _ = println (to_string ht.["y"])
// --- Output:
100
200
()
